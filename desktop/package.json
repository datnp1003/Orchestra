{
  "name": "orchestra-desktop",
  "productName": "Orchestra Desktop",
  "version": "0.2.0",
  "description": "Orchestra Desktop — IDE agent orchestrator độc lập: điều phối agent CLI trong pipeline có gate",
  "main": "out/desktop/src/main/main.js",
  "type": "module",
  "private": true,
  "author": "orchestra-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/datnp1003/Orchestra.git"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/js-yaml": "^4.0.9",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@lydell/node-pty-win32-x64": "^1.2.0-beta.18",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.1.0"
  },
  "build": {
    "appId": "dev.orchestra.desktop",
    "productName": "Orchestra Desktop",
    "files": [
      "out/**",
      "src/preload.cjs",
      "assets/**",
      "src/renderer/**",
      "prototype/templates/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../prototype/hooks",
        "to": "prototype/hooks",
        "filter": [
          "guard.cjs"
        ]
      },
      {
        "from": "../prototype",
        "to": "prototype",
        "filter": [
          "policy.yml"
        ]
      },
      {
        "from": "../prototype/templates",
        "to": "prototype/templates"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@lydell/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "datnp1003",
      "repo": "Orchestra"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true
    }
  }
}
