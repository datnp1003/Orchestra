{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "out",
    "rootDir": "..",
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "../prototype/src/**/*.ts"]
}
