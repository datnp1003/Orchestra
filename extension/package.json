{
  "name": "orchestra",
  "displayName": "Orchestra",
  "description": "%ext.description%",
  "publisher": "orchestra-dev",
  "version": "0.2.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon128.png",
  "main": "./out/extension/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orchestra-sidebar",
          "title": "Orchestra",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "orchestra-sidebar": [
        {
          "id": "orchestra.chatView",
          "name": "%view.chat%",
          "type": "webview"
        },
        {
          "id": "orchestra.fleetView",
          "name": "%view.fleet%"
        },
        {
          "id": "orchestra.tasksView",
          "name": "%view.tasks%"
        }
      ]
    },
    "configuration": {
      "title": "Orchestra",
      "properties": {
        "orchestra.defaultRepo": {
          "type": "string",
          "default": "",
          "description": "%config.defaultRepo%"
        },
        "orchestra.autoApprovePlan": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoApprovePlan%"
        },
        "orchestra.hooksEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.hooksEnabled%"
        },
        "orchestra.templatesDir": {
          "type": "string",
          "default": "",
          "description": "%config.templatesDir%"
        },
        "orchestra.orchestratorWorker": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "codex"
          ],
          "description": "%config.orchestratorWorker%"
        }
      }
    },
    "commands": [
      {
        "command": "orchestra.dispatch",
        "title": "%cmd.dispatch%"
      },
      {
        "command": "orchestra.runPipeline",
        "title": "%cmd.runPipeline%"
      },
      {
        "command": "orchestra.showMatrix",
        "title": "%cmd.showMatrix%"
      },
      {
        "command": "orchestra.reviewMerge",
        "title": "%cmd.reviewMerge%"
      },
      {
        "command": "orchestra.installWorker",
        "title": "%cmd.installWorker%"
      },
      {
        "command": "orchestra.refreshViews",
        "title": "%cmd.refreshViews%",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node test/run-tests.cjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
